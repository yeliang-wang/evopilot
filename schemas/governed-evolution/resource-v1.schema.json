{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/governed-evolution/resource-v1.schema.json",
  "title": "EvoPilot Governed Evolution Resource v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "provenance", "compatibility", "capabilityRefs", "spec"],
  "properties": {
    "apiVersion": { "const": "evopilot.io/v1" },
    "kind": { "enum": ["CapabilityPack", "LifecycleModule", "PolicyPack", "GovernancePack", "ActionProviderDefinition", "EnvironmentBinding", "ReleaseChannelBinding", "SecretRef", "HumanAuthorityRole"] },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "sourceId", "sourceVersion", "sourceDigest"],
      "properties": {
        "sourceType": { "enum": ["LEGACY_SUITE", "NATIVE", "PROJECT"] },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "sourceRef": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime"],
      "properties": { "runtime": { "type": "string", "minLength": 1 }, "expert": { "type": "string", "minLength": 1 } }
    },
    "capabilityRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "spec": { "type": "object" },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
