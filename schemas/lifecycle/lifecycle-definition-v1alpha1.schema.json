{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/lifecycle/lifecycle-definition-v1alpha1.schema.json",
  "title": "EvoPilot LifecycleDefinition v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "metadata", "stages"],
  "properties": {
    "schema": { "const": "evopilot-lifecycle-definition/v1alpha1" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": { "id": { "type": "string" }, "version": { "type": "string" } }
      }
    },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": {
        "input": { "type": "string" },
        "equals": { "type": ["string", "number", "boolean"] },
        "exists": { "type": "boolean" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["string", "integer", "number", "boolean", "enum", "string-array", "secret-ref"] },
        "prompt": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "default": {},
        "options": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
        "pattern": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "visibleWhen": { "$ref": "#/$defs/condition" },
        "sensitive": { "type": "boolean" },
        "review": { "type": "boolean" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "action", "decision"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "needs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "when": { "$ref": "#/$defs/condition" },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uses"],
          "properties": { "uses": { "type": "string" }, "with": { "type": "object" } }
        },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["AUTO", "POLICY", "HUMAN", "EXTERNAL_SIGNAL", "DISABLED"] },
            "authority": { "enum": ["plan", "credential", "production", "release", "publication", "exception", "recovery"] },
            "prompt": { "type": "string" }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts"],
          "properties": { "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 } }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    }
  }
}
