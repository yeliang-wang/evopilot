{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/lifecycle/agent-runtime-profile-v1.schema.json",
  "title": "EvoPilot AgentRuntimeProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "adapterId", "runtime", "host", "provider", "model", "capabilities", "constraints", "digest"],
  "properties": {
    "schema": { "const": "evopilot-agent-runtime-profile/v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "adapterId": { "type": "string", "minLength": 1 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "host": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceRoot", "permissionMode", "timeoutMs", "maxOutputBytes"],
      "properties": {
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "permissionMode": { "const": "HOST_MANAGED_DENY_UNDECLARED" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 7200000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 }
      }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
