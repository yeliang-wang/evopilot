{
  "name": "evopilot",
  "version": "5.1.0",
  "private": true,
  "description": "GA Release V1.0 Loop Engineering and self-evolution control plane for AI agent products.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "roadmap:check": "node scripts/roadmap-gate.mjs",
    "roadmap:gate": "node scripts/roadmap-gate.mjs",
    "roadmap:release": "node scripts/roadmap-gate.mjs --release-version",
    "build": "npm run build --workspaces --if-present",
    "cli": "node packages/cli/dist/index.js",
    "cli:build": "npm run build -w @evopilot/cli",
    "cli:test": "npm run build -w @evopilot/cli && node --test tests/functional/cli.test.mjs",
    "cli:pack": "npm pack -w @evopilot/contracts --dry-run && npm pack -w @evopilot/client --dry-run && npm pack -w @evopilot/cli --dry-run && npm pack -w create-evopilot --dry-run",
    "dashboard": "node -e \"console.log('Dashboard moved to ../evopilot-dashboard. Run npm run dev in that repository.')\"",
    "server": "node packages/server/dist/index.js",
    "server:debug": "EVOPILOT_RUN_MODE=debug node packages/server/dist/index.js",
    "code-upgrader": "node scripts/internal-code-upgrader.mjs",
    "loop-worker": "npm run build -w @evopilot/worker-runtime && node scripts/loop-worker.mjs",
    "loop:soak": "node scripts/loop-soak.mjs",
    "saas-ga:ladder": "node scripts/saas-ga-ladder-runner.mjs",
    "store:postgres:migrate": "npm run build && node scripts/postgres-business-store.mjs migrate",
    "store:postgres:backup": "npm run build && node scripts/postgres-business-store.mjs backup",
    "store:postgres:restore": "npm run build && node scripts/postgres-business-store.mjs restore",
    "self-loop": "node scripts/evopilot-self-loop.mjs",
    "check": "npm run roadmap:check && npm run build && npm test && npm run test:open-lifecycle:nonfunctional && npm run verify:v5 && npm run verify:production-assets && npm run verify:oss-governance && npm run verify:architecture && npm run verify:distribution && npm run audit:security",
    "test": "npm run test:unit && npm run test:smoke && npm run test:functional && npm run test:e2e",
    "test:unit": "npm run build && node --test tests/unit/*.test.mjs",
    "test:smoke": "npm run build && node --test tests/smoke/*.test.mjs",
    "test:functional": "npm run build && node --test tests/functional/*.test.mjs",
    "test:e2e": "npm run build && node --test tests/e2e/*.test.mjs",
    "test:agent-adapters": "npm run build -w @evopilot/adapter-opencode && node --test tests/functional/agent-runtime-adapters.test.mjs",
    "test:open-lifecycle:nonfunctional": "npm run build -w @evopilot/server && node scripts/open-lifecycle-nonfunctional.mjs",
    "test:failure-recovery": "node scripts/failure-recovery-matrix.mjs",
    "proofops-mode:check": "npm run build && node --test tests/functional/proofops-target-loop.test.mjs",
    "loop-runtime:check": "npm run build && node --test tests/functional/loop-runtime.test.mjs tests/functional/loop-worker.test.mjs",
    "test:e2e:real-llm": "npm run build && node scripts/real-llm-e2e.mjs",
    "test:e2e:production": "npm run build && node scripts/production-e2e.mjs",
    "release:soak:ga": "node scripts/ga-soak.mjs",
    "release:soak:ga:active": "node scripts/run-active-ga-soak.mjs",
    "release:artifact": "node scripts/build-release-artifacts.mjs",
    "evolution-expert:release:artifact": "node scripts/build-evolution-expert-release-artifacts.mjs",
    "release:ready": "node scripts/release-ready.mjs",
    "ecs:immutable-rollout": "node scripts/immutable-rollback-runbook.mjs",
    "verify:release-artifact": "node scripts/verify-release-artifacts.mjs",
    "verify:evolution-expert-release-artifact": "node scripts/verify-evolution-expert-release-artifacts.mjs",
    "verify:release-pipeline": "node scripts/verify-release-pipeline.mjs",
    "verify:distribution": "node scripts/verify-helm-chart.mjs && node scripts/verify-distribution-readiness.mjs",
    "verify:npm-registry": "node scripts/verify-npm-registry-publication.mjs",
    "verify:production-assets": "node scripts/verify-production-assets.mjs",
    "verify:oss-governance": "node scripts/verify-open-source-governance.mjs",
    "verify:architecture": "node scripts/verify-architecture-boundaries.mjs",
    "completion:contract": "npm run build -w @evopilot/core && node scripts/build-v5-completion-contract.mjs",
    "completion:contract:check": "npm run build -w @evopilot/core && node scripts/build-v5-completion-contract.mjs --check",
    "verify:v5:completion": "npm run completion:contract:check && node scripts/verify-v5-completion.mjs",
    "verify:v5": "npm run build -w @evopilot/core && npm run build -w @evopilot/evolution-expert && node packages/evolution-expert/scripts/generate-adapters.mjs --check && node scripts/verify-v5-governed-evolution.mjs && npm run verify:v5:completion",
    "suite:inventory": "npm run build -w @evopilot/core && node scripts/build-suite-capability-inventory.mjs",
    "verify:runtime-lock": "node scripts/verify-runtime-lock.mjs",
    "verify:runtime-lock:strict": "EVOPILOT_REQUIRE_RUNTIME_LOCK=1 node scripts/verify-runtime-lock.mjs",
    "audit:security": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
