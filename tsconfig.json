{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "integration/composition.ts",
    "integration/connection/client.ts",
    "integration/connection/config.ts",
    "integration/connection/control.ts",
    "integration/connection/daemon.ts",
    "expert/core/guide.ts",
    "plugins/codex/server.ts",
    "integration/types.ts",
    "integration/compatibility/v1/reference.d.mts",
    "integration/workspace/**/*.ts",
    "integration/toolchain/**/*.ts",
    "integration/collection/**/*.ts",
    "expert/core/acceptance.ts",
    "expert/core/native-acceptance.ts",
    "integration/online/**/*.ts",
    "integration/response/**/*.ts",
    "integration/consumption/**/*.ts",
    "integration/usability/**/*.ts"
  ]
}
